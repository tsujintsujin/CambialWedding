# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Sets the absolute base for Open Graph image URLs.
# NEXT_PUBLIC_SITE_URL=https://cambial-cogtong.vercel.app

# Server only. Email notifications on new RSVPs and guestbook notes.
# Without this the site works exactly as before; nothing is sent.
RESEND_API_KEY=your-resend-api-key

# Optional. Resend only delivers from a domain you have verified; until one is
# set up it falls back to Resend's shared sandbox sender, which reaches the
# Resend account owner only.
# RESEND_FROM=Leisther & Cristine <hello@your-verified-domain.com>

# Optional. Pins who gets notified. Left unset, the most recently signed-in
# Supabase Auth account is used — see the note in app/lib/notify.ts about this
# project being shared with another app.
# ADMIN_NOTIFY_EMAIL=weddbyjustin@gmail.com

# Who may open /admin. Comma-separated, matched against the signed-in email.
# Being signed in is NOT enough — this project's Supabase sign-up endpoint is
# reachable with the anon key, and the project is shared with another app.
# Unset means nobody gets in, which is deliberate: it fails closed.
ADMIN_EMAILS=lescris@wedd.space
